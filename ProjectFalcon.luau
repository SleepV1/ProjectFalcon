local function choiceRow(o, order, isBind)
	local b = Instance.new("TextButton")
	b.AutoButtonColor = false
	b.BackgroundTransparency = 1
	b.Text = ""
	b.Size = UDim2.new(1, 0, 0, 22)
	b.LayoutOrder = order

local function closePanel()
	local previous = panelMod
	if panelMod then
		for _, c in ipairs(panelMod.uiConns or {}) do
			c:Disconnect()
		end
		panelMod.uiConns = {}
	end
	binding = nil
	panelMod = nil
	moduleState = nil
	panel.Visible = false
	if previous and previous.paint then previous.paint() end
end

